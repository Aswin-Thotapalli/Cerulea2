# ── Chain RPC endpoints (WebSocket) ─────────────────────────────────────────
# Set these to your Substrate node WebSocket URLs.
# Local dev example: ws://localhost:9944 / ws://localhost:9945
NEXT_PUBLIC_RPC_WS_PUBLIC=wss://rpc.cerulea.io/public
NEXT_PUBLIC_RPC_WS_PRIVATE=wss://rpc.cerulea.io/private

# ── Cerulea REST API (indexed/historical data) ───────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://api.cerulea.io

# ── Authentication (shared with Studio/Dashboard) ───────────────────────────
# MUST match the NEXTAUTH_SECRET used by apps/frontend
NEXTAUTH_URL=https://explorer.cerulea.io
NEXTAUTH_SECRET=your-nextauth-secret-here

# Cookie domain shared across cerulea.io subdomains
AUTH_COOKIE_DOMAIN=.cerulea.io

# ── Local dev overrides (.env.local) ─────────────────────────────────────────
# NEXT_PUBLIC_RPC_WS_PUBLIC=ws://localhost:9944
# NEXT_PUBLIC_RPC_WS_PRIVATE=ws://localhost:9945
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# NEXTAUTH_URL=http://localhost:3002
# AUTH_COOKIE_DOMAIN=localhost
