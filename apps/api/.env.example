# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000

# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite file. Created automatically on first run.
DB_PATH=./data/cerulea.db

# ── Substrate RPC nodes ───────────────────────────────────────────────────────
# WebSocket URL of your public chain node (port 9944 by default on Substrate)
RPC_WS_PUBLIC=ws://localhost:9944

# WebSocket URL of your private chain node
RPC_WS_PRIVATE=ws://localhost:9945

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Use * for local dev, specific domains in production.
CORS_ORIGIN=http://localhost:3002,https://explorer.cerulea.io

# ── Indexer ───────────────────────────────────────────────────────────────────
# How many past blocks to backfill on startup (0 to disable)
BACKFILL_BLOCKS=200
