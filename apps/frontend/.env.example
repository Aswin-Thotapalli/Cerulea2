# Cerulea Studio environment
# Copy this file to .env.local and fill every value.
# Studio holds no database connection and no outside service key. Every
# account, project, Blueprint, subscription and Cerulea AI read or write passes
# through Cerulea APIs at the address below.

# The address Cerulea APIs listens on, read on the server.
CERULEA_API_URL=http://localhost:4000
# The same address, read in the browser.
NEXT_PUBLIC_CERULEA_API_URL=http://localhost:4000

# The address Studio itself is served on. The studio host serves the division
# chooser at its root and the three divisions at /dapps, /enterprise and /govt.
NEXTAUTH_URL=http://studio.localhost:3011
# The secret signing the browser session. Generate a long random value.
NEXTAUTH_SECRET=

# The cookie domain shared across the Studio, Dashboard and administration
# hosts in a hosted deployment, for example .cerulea.io. Leave it empty on this
# machine, since browsers refuse a shared cookie domain on localhost.
AUTH_COOKIE_DOMAIN=
