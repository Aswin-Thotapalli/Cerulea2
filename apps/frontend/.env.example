# apps/frontend/.env.example
# Copy to .env.local and fill in real values. Never commit .env.local.

# --- NextAuth / Auth.js ---
NEXTAUTH_URL=http://studio.localhost:3000
NEXTAUTH_SECRET=
# Production only — do NOT set for local dev (Chrome rejects Domain=localhost for subdomains)
# AUTH_COOKIE_DOMAIN=.cerulea.app

# --- Postgres (Neon) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require"

# --- Resend ---
RESEND_API_KEY=
EMAIL_FROM=noreply@cerulea.app

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Stripe (Studio billing — tiers + add-ons) ---
# Leave all of these unset to run in dev-mode: checkout/add-on changes are
# applied directly to the DB with no real Stripe charge, useful for local
# development without Stripe keys. Set them all to enable live billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Run `npm run stripe:setup-billing` (after setting STRIPE_SECRET_KEY above)
# to create these Products/Prices in Stripe and print their ids.
STRIPE_PRICE_PUBLIC_DAPPS=
STRIPE_PRICE_PRIVATE_DAPPS=
STRIPE_PRICE_PRIVATE_DAPPS_PRO=

STRIPE_PRICE_ADDON_VALIDATOR_SINGLE=
STRIPE_PRICE_ADDON_VALIDATOR_MULTI=
STRIPE_PRICE_ADDON_STORAGE_10GB=
STRIPE_PRICE_ADDON_DEDICATED_RPC=
STRIPE_PRICE_ADDON_CUSTOM_DOMAIN=
STRIPE_PRICE_ADDON_BLOCK_EXPLORER_SETUP=
STRIPE_PRICE_ADDON_BLOCK_EXPLORER_HOSTING=
STRIPE_PRICE_ADDON_API_KEY=
STRIPE_PRICE_ADDON_STUDIO_SEAT=

STRIPE_PRICE_EXPORT_CHAIN_DATA=
