# Cerulea Studio environment
# Copy this file to .env.local and fill every value.
# Studio holds no database connection. Every read and write passes through
# Cerulea APIs at the address below.

# The address Cerulea APIs listens on, read on the server.
CERULEA_API_URL=http://localhost:4000
# The same address, read in the browser.
NEXT_PUBLIC_CERULEA_API_URL=http://localhost:4000

# The address Studio itself is served on.
NEXTAUTH_URL=http://localhost:3000
# The secret signing the browser session. Generate a long random value.
NEXTAUTH_SECRET=

# The cookie domain shared across the Studio, Dashboard and Explorer hosts.
AUTH_COOKIE_DOMAIN=

# The addresses holding the Cerulea operator role, separated by commas.
# The administration screens open for these addresses alone.
CERULEA_OPERATOR_EMAILS=
