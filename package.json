{
  "name": "cerulea-studio",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:frontend": "turbo build --filter=frontend",
    "build:explorer": "turbo build --filter=explorer",
    "dev": "turbo dev",
    "dev:frontend": "turbo dev --filter=frontend",
    "dev:explorer": "turbo dev --filter=explorer",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "latest"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "20.x"
  }
}