{
  "name": "cerulea-studio",
  "private": true,
  "scripts": {
    "build": "turbo build --filter=frontend",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "pnpm --filter frontend run test",
    "typecheck": "pnpm --filter frontend run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "workspaces": [
    "apps/*"
  ],
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "latest"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=18"
  }
}
